DATABASE_URL=postgres://chatrpg:chatrpg@localhost:54323/chatrpg
TRPG_LLM_PROVIDER=openai
TRPG_LLM_BASE_URL=https://api.openai.com/v1
TRPG_LLM_API_KEY=replace_me
TRPG_LLM_MODEL=gpt-4.1
TRPG_LLM_SEND_TEMPERATURE=false
TRPG_DATA_DIR=./data
TRPG_API_ADDR=127.0.0.1:8787
TRPG_MEMORY_RETRIEVAL_LIMIT=8
TRPG_MEMORY_SNAPSHOT_EVERY_TURNS=8

TRPG_SEARCH_INDEX_DIR=./data/search/tantivy_v3
TRPG_SEARCH_WRITER_MEMORY_BYTES=96000000

# Runtime retrieval loop
TRPG_RUNTIME_AUTO_SEARCH=true
TRPG_RUNTIME_AUTO_SEARCH_LIMIT=5
TRPG_RUNTIME_AUTO_SEARCH_MAX_SCENE_PINS=1
TRPG_RUNTIME_AUTOPIN_SCENE_RULES=true
TRPG_RUNTIME_AUTO_SEARCH_DOMAINS=learned,rules,modules,rulings,source,parsed
TRPG_SEARCH_CJK_EXPANSION=true

# PDF ingestion. auto = oxidize-pdf first, fallback to pdftotext.
TRPG_PDF_BACKEND=oxidize
TRPG_PDF_ALLOW_PDFTOTEXT_FALLBACK=true
TRPG_OXIDIZE_CLEAN_MODE=heuristic
TRPG_OXIDIZE_CHUNK_TARGET_CHARS=4000
TRPG_OXIDIZE_WRITE_RAW_CHUNKS=true
TRPG_INGEST_LLM_CLEAN=false
TRPG_INGEST_LLM_CLEAN_MAX_CHUNKS=8
TRPG_INGEST_SEMANTIC_UNITS=true
TRPG_SEMANTIC_UNIT_MAX_CHARS=6000
TRPG_INGEST_LLM_SEMANTIC_WASH=false
TRPG_INGEST_LLM_SEMANTIC_WASH_MAX_UNITS=12
# v1.16.1: first rulebook onboarding uses Rule Steward Agent skills by default.
TRPG_RULE_STEWARD_FIRST_PASS=true

# LLM retry / player-visible safety
TRPG_LLM_MAX_RETRIES=3
TRPG_LLM_RETRY_BASE_MS=800
TRPG_REDACT_GM_ONLY_SEARCH_HITS=true
TRPG_REDACT_GM_ONLY_PROMPT_TERMS=true
# Comma-separated module-secret terms to mask in player-facing prompts until discovered in-fiction.
TRPG_SECRET_TERM_OVERRIDES=Athena,Shelob

# Learning write-side audit. Default writes rulings_log + learning_candidates, not learned_packets.
TRPG_LEARNING_AUDIT=true
# Keep false by default: use `trpg learn approve <candidate_id>` for the safety gate.
TRPG_LEARNING_AUTO_PROMOTE=false

TRPG_AGENT_ADVICE_DIR=./data/agent/advice
TRPG_AGENT_ENABLE_V09=true
TRPG_AGENT_TABLE_DICE_POLICY=system_rolls_visible

# v0.9.1 interaction-gate defaults are data-driven; these are reserved for future table overrides.
TRPG_GATE_UNPARSEABLE_POLICY=reprompt
TRPG_GATE_NEW_ACTION_POLICY=cancel_gate_and_continue
TRPG_STATE_FRAME_ACTIVE_LIMIT=4

# v1.0 conflict/combat frame runtime
TRPG_CONFLICT_AGENT_ENABLE_V10=true
TRPG_SITUATION_ORCHESTRATOR_ENABLE_V11=true
TRPG_SITUATION_STALEMATE_TURNS=3
TRPG_RULESET_ADVICE_DIR=./data/ruleset_advice
TRPG_COMBAT_AUTO_FRAME=true
TRPG_COMBAT_COMPACTION=true

# v1.2/v1.3 actionable situation director
TRPG_ACTIONABLE_DIRECTOR_ENABLE_V12=true
TRPG_ACTIONABLE_DIRECTOR_ENABLE_V13=true
TRPG_DIRECTOR_BRIEF_EVERY_TURN=false
TRPG_DIRECTOR_DEFAULT_GUIDANCE_LEVEL=ask_goal
TRPG_DIRECTOR_CLOCK_ON_STALL=true
TRPG_DIRECTOR_MIN_COSTED_EXAMPLES=3

# v1.3 actionable + novelty situation director runtime
TRPG_ACTIONABLE_DIRECTOR_ENABLE_V12=true
TRPG_ACTIONABLE_DIRECTOR_ENABLE_V13=true
TRPG_ACTIONABLE_DIRECTOR_MAX_EXAMPLES=4
TRPG_ACTIONABLE_DIRECTOR_MENU_COOLDOWN=2

# v1.3 novelty / anti-repetition runtime
TRPG_NOVELTY_DIRECTOR_ENABLE_V13=true
TRPG_NPC_MAX_REPEAT_TACTIC=1
TRPG_OUTPUT_NO_REPEAT_VALIDATOR=true
TRPG_DIRECTION_GATE_AUTO_DEFAULT_AFTER_REPROMPTS=2

# v1.4 World Time Spine
TRPG_WORLD_TIME_ENABLE_V14=true
TRPG_WORLD_TIME_START_DISPLAY="Day 1, 00:00"
TRPG_WORLD_TIME_CALENDAR_ID=relative_default
TRPG_WORLD_TIME_CONTEXT_EVENT_LIMIT=24
TRPG_WORLD_TIME_AUTO_ADVANCE_PER_TURN_SECONDS=0

# v1.5 interaction lifecycle kernel
TRPG_INTERACTION_KERNEL_ENABLE_V15=true
TRPG_INTERACTION_RECONCILE_EVERY_TURN=true
TRPG_INTERACTION_CASCADE_CLOSE_FRAME=true
TRPG_INTERACTION_GENERATION_GUARD=true

# v1.6 Object & Possession Kernel
TRPG_OBJECT_KERNEL_ENABLE_V16=true
TRPG_OBJECT_INTERACTION_AUTOCONTRACT=true
TRPG_OBJECT_CONTEXT_BP3=true
TRPG_OBJECT_COMPACTION_ENABLE=true
TRPG_OBJECT_DEFAULT_DISARM_TARGET=15

# v1.7 turn orchestration / reducer routing
TRPG_TURN_ORCHESTRATOR_ENABLE_V17=true
TRPG_TURN_ORCHESTRATOR_GATE_RELEVANCE=true
TRPG_TURN_ORCHESTRATOR_FRAME_FIRST=true
TRPG_TURN_ORCHESTRATOR_OBJECT_AS_CHILD=true
TRPG_TURN_ORCHESTRATOR_DISABLE_GENERIC_CHECK_FOR_FRAME_ACTION=true

# v1.8 runtime material binding / parameter hydration
TRPG_RUNTIME_PARAM_HYDRATION_ENABLE_V18=true
TRPG_OBJECT_BIND_NARRATION_TO_RULES_V18=true
TRPG_OBJECT_SESSION_SCOPED_IDS=true
TRPG_ORCHESTRATOR_OBJECT_SELF_SELECT=false
TRPG_REQUIRED_REACTION_BLOCKS_OBJECT_INTENT=true

# v1.9 semantic rule binding and ability hydration
TRPG_SEMANTIC_PRIMARY=true
TRPG_SEMANTIC_CLASSIFIER_ENABLE_V19=true
TRPG_SEMANTIC_EXTRACTOR_ENABLE_V19=true
TRPG_LEXICAL_FALLBACK_ENABLE=false
TRPG_LEXICAL_FALLBACK_AUDIT_ONLY=true
TRPG_ABILITY_KERNEL_ENABLE_V19=true
TRPG_RULE_BINDING_ENABLE_V19=true
TRPG_RULE_BINDING_REQUIRE_RUNTIME_WRITEBACK=true
TRPG_ABILITY_CONTEXT_BP3=true

# v1.9.1 semantic route stability hotfix
TRPG_SEMANTIC_ROUTE_REDUCER_STRICT=true
TRPG_SEMANTIC_ROUTE_CACHE_ENABLE=true
TRPG_SEMANTIC_RECORD_REPLAY_ENABLE=false
TRPG_DIRECTION_GATE_AUTO_DEFAULT_AFTER_REPROMPTS=2

# v1.10 real materialization extractor
TRPG_REAL_MATERIALIZATION_ENABLE_V110=true
TRPG_REAL_MATERIALIZATION_EXTRACTOR_ENABLE_V110=true
TRPG_MATERIALIZATION_REQUIRE_SOURCE_OR_PROVISIONAL_REASON=true
TRPG_MATERIALIZATION_BLOCKING_FOR_MECHANICS=true
TRPG_MATERIALIZATION_CONTEXT_BP3=true
TRPG_MATERIALIZATION_PREFER_MODULE_CARDS=true

# v1.10.1 simulation-guided hotfix
TRPG_SIMULATION_GUIDED_HOTFIX_V1101=true
TRPG_FORCE_TECH_ASSESSMENT_CHECK=true
TRPG_REACTION_REPROMPT_EMITS_WINDOW=true

# v1.10.2 Player-supplied value referee
TRPG_PLAYER_VALUE_REFEREE_ENABLE_V1102=true
TRPG_PLAYER_VALUE_ALLOW_TABLE_OVERRIDE=true
TRPG_PLAYER_VALUE_REQUIRE_RULE_OR_TABLE_CHECK=true

# v1.10.2 Referee Combat Slice
TRPG_REFEREE_COMBAT_SLICE_ENABLE_V1102=true
# v1.15.4: do not set TRPG_COMBAT_DEFAULT_ATTACK_DV unless intentionally overriding source-backed rules.
TRPG_MECHANICAL_LEDGER_CONTEXT_BP3=true

# v1.11 Contest / Opposition Kernel
TRPG_CONTEST_KERNEL_ENABLE_V111=true
# v1.15.4: do not set TRPG_CONTEST_DEFAULT_ATTACK_DV unless intentionally overriding source-backed rules.
# v1.15.4: do not set TRPG_CONTEST_DEFAULT_DEFENSE_DV unless intentionally overriding source-backed rules.
# TRPG_CONTEST_DEFAULT_PERCENTILE_SKILL=50  # optional table override only; default unset
TRPG_CONTEST_CONTEXT_BP3=true
TRPG_CONTEST_REQUIRE_MODEL_FOR_CHECK=true

# v1.12 Mechanics Search Skills & Parameter Binding
TRPG_MECHANICS_SEARCH_SKILLS_ENABLE_V112=true
TRPG_MECHANICS_SEARCH_MULTI_STEP=true
TRPG_MECHANICS_SEARCH_USE_RULESET_LOCATORS=true
TRPG_MECHANICS_SEARCH_WRITE_FACETS=true
TRPG_MECHANICS_SEARCH_CONTEXT_BP3=true
TRPG_MECHANICS_SEARCH_GREP_CANDIDATES_ONLY=true

# v1.12.1 Unified Roll & Effect Executor
TRPG_UNIFIED_ROLL_EFFECT_EXECUTOR_ENABLE_V1121=true
TRPG_AGENT_TABLE_DICE_POLICY=system_rolls_visible
TRPG_EFFECT_CONTEXT_BP3=true
# v1.15.4: do not default unknown armor/SP to 0; hydrate from source-backed parameters.
TRPG_EFFECT_ALLOW_PROVISIONAL_TARGET_PARAMETER=false
TRPG_STRICT_SOURCE_BACKED_MATERIALIZATION=true
TRPG_FAIL_ON_MISSING_SOURCE_BACKED_PARAMS=true
# v1.16.2: default product behavior degrades missing source-bound params into provisional narration instead of aborting the turn.
TRPG_GRACEFUL_DEGRADE_MISSING_SOURCE_PARAMS=true
TRPG_ALLOW_SYNTHETIC_ACTOR_SEEDS=false
TRPG_EFFECT_REQUIRE_PARAMETER_IMPACT=true

# v1.12.2 Roll Binding & Mechanical Gate Priority Hotfix
TRPG_ROLL_BINDING_HOTFIX_ENABLE_V1122=true
TRPG_ROLL_BINDING_USE_LATEST_UNRESOLVED_CHECK=true
TRPG_DIRECTION_GATE_IS_ADVISORY=true
# v1.15.4: do not set TRPG_COMBAT_DEFAULT_ATTACK_EXPR unless intentionally overriding source-backed actor parameters.
TRPG_AUTO_RESOLVE_SYSTEM_EFFECT_ROLLS=true

# v1.13 Parameter Facet Executor & Starter Mechanical Profiles
TRPG_PARAMETER_FACET_EXECUTOR_ENABLE_V113=true
TRPG_PARAMETER_FACET_EXECUTOR_USE_BOUND_FACETS_FIRST=true
TRPG_PARAMETER_FACET_EXECUTOR_USE_RULESET_STARTER_PROFILES=false
TRPG_PARAMETER_FACET_EXECUTOR_WRITE_GENERIC_STATES=true
TRPG_PARAMETER_FACET_EXECUTOR_CONTEXT_BP3=true
TRPG_PARAMETER_FACET_EXECUTOR_AUDIT_PROVISIONAL=true

# v1.13.1 Combat Route Source Object Hotfix
TRPG_COMBAT_ROUTE_SOURCE_OBJECTS_AS_ATTACKS=true
TRPG_COMBAT_COMMIT_FRAME_START_ACTION=true
TRPG_ORCHESTRATOR_ATTACK_OVER_OBJECT_MATERIALIZATION=true
TRPG_SEMANTIC_COMBAT_INTENT_ENABLE_V1133=true
TRPG_SEMANTIC_COMBAT_LEXICAL_FALLBACK_AUDIT=true
TRPG_SUSTAINED_COMBAT_LOOP_POLICY_V1133=true
TRPG_DETERMINISTIC_ROLL_AUTHORITY_V1133=true
TRPG_DIRECTION_GATE_ADVISORY_FOR_FRAME_ACTIONS=true


# v1.13.2 roll/effect gate closure
TRPG_ROLL_EFFECT_GATE_CLOSURE_ENABLE_V1132=true
TRPG_AUTO_CLOSE_RESOLVED_CHECK_GATES=true
TRPG_PROTECT_ROLL_REPLIES_FROM_SEMANTIC_OVERRIDE=true


# v1.14 External Playtest Evaluator
TRPG_EXTERNAL_PLAYTEST_EVALUATOR_ENABLE_V114=true
TRPG_PLAYTEST_EVALUATOR_BACKEND=claude-code
TRPG_PLAYTEST_CLAUDE_BIN=claude
TRPG_PLAYTEST_EXPORT_DB_DIFF=true
TRPG_PLAYTEST_FORBID_RULE_TABLE_ASKS=true

# Source-backed parameters. Keep false to avoid invented NPC HP/SP/skills/loadouts.
TRPG_RUNTIME_PARAM_ALLOW_SYNTHETIC_NPC_SEEDS=false
TRPG_MATERIALIZATION_WRITE_PARTIAL=false

# v1.16 Rule Steward Agent + Character Onboarding Pack
TRPG_RULE_STEWARD_ENABLE_V116=true
TRPG_RULE_STEWARD_AUTO_QUERY=true
TRPG_CHARACTER_ONBOARDING_REQUIRED=true
TRPG_PLAYABILITY_GATE_BLOCKING=false
TRPG_PLAYABILITY_REQUIRE_DERIVED_FORMULAS=true
TRPG_RULE_KERNEL_PATCH_AUTO_APPLY=false
TRPG_RULE_STEWARD_STRICT_SOURCE_BACKED=true
# 刺激驱动检定预 pass（J2 SAN 修复）：回合头部目录 when_to_use × 虚构内容语义
# 命中 → 阻塞性 MechanicDue（roll_check {mechanic_id} 处理或 waive 豁免）。默认开。
TRPG_STIMULUS_CHECK_TRIGGER=true
